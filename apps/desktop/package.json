{
  "name": "@tucools/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "本地图像工具",
  "homepage": "https://github.com/dingdangdog/tucools",
  "main": "main.js",
  "author": {
    "name": "图酷"
  },
  "scripts": {
    "dev": "electron .",
    "package:win": "electron-builder --win nsis --x64",
    "package:mac": "electron-builder --mac dmg zip --arm64 --x64",
    "package:linux": "electron-builder --linux AppImage deb --x64"
  },
  "dependencies": {
    "busboy": "^1.6.0"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tucools.app",
    "productName": "图酷",
    "electronVersion": "35.7.5",
    "asar": true,
    "npmRebuild": false,
    "extraMetadata": {
      "name": "tucools"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "host.js",
      "model-pack.js",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../services/engine",
        "to": "engine",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/tmp/**",
          "!**/.venv/**",
          "!**/models/**",
          "!**/model-pack/**",
          "!**/*.onnx",
          "!**/*.pt",
          "!**/*.param",
          "!**/upscayl-bin*"
        ]
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "TuCools-${version}-windows-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false,
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "artifactName": "TuCools-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "category": "Graphics",
      "icon": "build/icon.png",
      "executableName": "tucools",
      "synopsis": "本地图像工具",
      "maintainer": "图酷",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "artifactName": "TuCools-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    }
  }
}
